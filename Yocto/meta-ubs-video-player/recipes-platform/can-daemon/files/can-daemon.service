[Unit]
Description=Automotive CAN Daemon (Platform Layer - can0 Bridge)
After=systemd-udevd.service
Wants=systemd-udevd.service
# Continue retrying if hardware is absent or probes late.
StartLimitIntervalSec=0

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=can-daemon
Environment=LOG_LEVEL=INFO
ExecStartPre=/usr/bin/setup_can.sh
ExecStart=/usr/bin/can-daemon
Restart=always
RestartSec=5s
TimeoutStartSec=45s

[Install]
WantedBy=multi-user.target
