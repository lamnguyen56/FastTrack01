[Unit]
Description=USB Automotive Video Player (Qt QML HMI Application)
After=usb-monitor.service systemd-udevd.service systemd-modules-load.service
Wants=can-daemon.service usb-monitor.service

[Service]
Type=simple
# Give Qt a private runtime directory managed by systemd.
RuntimeDirectory=usb-video-player
RuntimeDirectoryMode=0700
Environment="XDG_RUNTIME_DIR=/run/usb-video-player"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usb-video-player
# Render directly on the display using the EGLFS DRM/KMS backend.
Environment="QT_QPA_PLATFORM=eglfs"
# Share the EGL/GLES video path with Qt Quick; requires the layer's Qt patches.
Environment="QT_GSTREAMER_USE_OPENGL_PLUGIN=1"
Environment="GST_GL_PLATFORM=egl"
Environment="GST_GL_API=gles2"
# Preserve the last frame with one readback on flush, instead of every frame.
Environment="QT_MULTIMEDIA_DEFER_FRAME_SNAPSHOT=1"
# Prefer the stateful V4L2 H.264 decoder when the driver exposes it.
# The app also enforces a video decoder allowlist before media creation.
Environment="GST_PLUGIN_FEATURE_RANK=v4l2h264dec:300,avdec_h264:0"
# Also support Qt builds without fontconfig by specifying the TTF directory.
Environment="QT_QPA_FONTDIR=/usr/share/fonts/truetype"
# Use the Qt5 default Controls style instead of forcing Qt6 Basic.
# Avoid starting EGLFS before a connected DRM output has display modes.
Environment="DISPLAY_WAIT_SECONDS=60"
ExecStartPre=/usr/bin/wait-for-display.sh
TimeoutStartSec=70s
ExecStart=/usr/bin/usb-video-player
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
