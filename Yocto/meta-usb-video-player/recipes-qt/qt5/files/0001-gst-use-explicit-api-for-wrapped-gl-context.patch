Qt Multimedia: specify the API of the wrapped Qt GL context

GStreamer 1.22 rejects GST_GL_API_ANY in gst_gl_context_new_wrapped().
Use the API of the Qt context instead so its GL video path can share it.

Upstream-Status: Pending

--- a/src/gsttools/qgstvideorenderersink.cpp
+++ b/src/gsttools/qgstvideorenderersink.cpp
@@ -368,7 +368,12 @@
     if (!nativeContext)
         qWarning() << "Could not find resource for" << contextName;
 
-    GstGLContext *appContext = gst_gl_context_new_wrapped(display, (guintptr)nativeContext, glPlatform, GST_GL_API_ANY);
+    // GStreamer requires the actual API when wrapping an existing context;
+    // GST_GL_API_ANY is a negotiation mask and is rejected by newer releases.
+    const GstGLAPI glApi = glContext->isOpenGLES() ? GST_GL_API_GLES2
+            : glContext->format().profile() == QSurfaceFormat::CoreProfile
+                ? GST_GL_API_OPENGL3 : GST_GL_API_OPENGL;
+    GstGLContext *appContext = gst_gl_context_new_wrapped(display, (guintptr)nativeContext, glPlatform, glApi);
     if (!appContext)
         qWarning() << "Could not create wrappped context for platform:" << glPlatform;
 
