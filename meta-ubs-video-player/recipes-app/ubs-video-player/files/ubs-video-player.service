[Unit]
Description=UBS Automotive Video Player (Qt QML HMI Application)
After=can-daemon.service usb-monitor.service systemd-udevd.service
Wants=can-daemon.service usb-monitor.service

[Service]
Type=simple
User=root
# Cấu hình biến môi trường Qt chạy mượt mà trên framebuffer / DRM KMS của bo nhúng
Environment="QT_QPA_PLATFORM=eglfs"
Environment="QT_QPA_EGLFS_ALWAYS_SET_MODE=1"
Environment="QT_QUICK_CONTROLS_STYLE=Basic"
ExecStart=/usr/bin/ubs-video-player
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
